# Copy to .env and fill in. NEVER commit .env — it is gitignored.

CROO_API_URL=https://api.croo.network
CROO_WS_URL=wss://api.croo.network/ws

# API key of the Haggle agent (provider + requester). From Dashboard, shown once.
HAGGLE_SDK_KEY=croo_sk_...

# API key of the demo buyer agent (places inbound run_auction orders).
BUYER_SDK_KEY=croo_sk_...

# Service ID of Haggle's run_auction service (from Dashboard after creating the service).
HAGGLE_SERVICE_ID=

# Hard spending caps (USDC). The engine refuses to exceed these.
MAX_USDC_PER_JOB=1.00
MAX_USDC_TOTAL=8.00
